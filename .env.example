# MongoDB Atlas URI. Vercel's MongoDB Atlas integration supplies MONGODB_URI.
MONGODB_URI=
MONGODB_DB=sarako

# One admin account only. No public registration is provided.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
AUTH_SECRET=

# Customize public-facing city identity and contact details.
NEXT_PUBLIC_CITY_NAME=SARAKO
NEXT_PUBLIC_CITY_TAGLINE=Malapit sa bawat mamamayan
NEXT_PUBLIC_EMERGENCY_NUMBER=911
